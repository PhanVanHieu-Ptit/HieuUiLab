# Optional build-time settings for the map viewer's online basemap, at /labs/maps/maplibre-viewer.
#
# With none of these set, the viewer draws its bundled basemap and makes no network requests, which
# is how the tests and CI run it. To try an online basemap, copy this file to .env.local, fill in
# the values, and restart the dev server or rebuild. .env.local is ignored by git.
#
# Vite inlines every VITE_ value into the JavaScript that each visitor downloads, so these are
# public. Never put a secret here. A key in a style URL is visible in the bundle and in the network
# panel; use a key the provider lets you restrict to your site's origin.
#
# On a host such as Vercel, set the same names in the project's environment variables (not in
# vercel.json), then redeploy: the values are inlined when the site is built, so a change does not
# reach a deployment that already exists. The code reads only the four names below. Do not add other
# VITE_ variables; pnpm dist:check fails a build whose output holds the value of one. See /docs/deployment.
#
# Read the provider's terms first: /docs/map-viewer on the site, or src/docs/content/map-viewer.md.
# Public tile servers are shared, best-effort services that can limit or block use.

# A MapLibre style document (a style.json), not a raw tile URL. Must be https; plain http is
# accepted only for localhost. It may contain {key}, which VITE_MAP_API_KEY replaces.
VITE_MAP_STYLE_URL=

# Needed only when the style URL contains {key}.
VITE_MAP_API_KEY=

# Required to enable the online basemap: the credit the provider's terms ask you to show, as plain
# text. The viewer shows it in the map and in the Basemap panel, and will not enable an online
# basemap without it.
VITE_MAP_ATTRIBUTION=

# Optional: how the Basemap panel names the provider. Defaults to the style URL's host name.
VITE_MAP_PROVIDER_NAME=
