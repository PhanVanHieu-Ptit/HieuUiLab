{
  "name": "hieu-ui-lab",
  "private": true,
  "version": "0.1.0",
  "description": "A React, TypeScript, and Tailwind CSS component lab: a registry of copy-and-own components and page blocks, with documentation, a playground, and example apps.",
  "license": "MIT",
  "author": "Hieu (https://github.com/PhanVanHieu-Ptit)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhanVanHieu-Ptit/HieuUiLab.git"
  },
  "bugs": {
    "url": "https://github.com/PhanVanHieu-Ptit/HieuUiLab/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "docs:check": "vitest run src/docs",
    "notes:check": "vitest run src/notes",
    "registry:check": "vitest run src/registry/shadcn",
    "registry:build": "vitest run src/registry/shadcn -u",
    "registry:install-test": "node scripts/registry-install-test.ts",
    "registry:failure-test": "node scripts/registry-failure-test.ts",
    "registry:verify-schema": "node scripts/registry-verify-schema.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "perf:measure": "node scripts/perf-measure.ts",
    "dist:check": "node scripts/check-dist.ts",
    "deploy:serve": "node scripts/serve-dist.ts",
    "deploy:smoke": "node scripts/smoke-deployment.ts",
    "deploy:e2e": "playwright test e2e/routes.spec.ts e2e/smoke.spec.ts e2e/maplibre-viewer.spec.ts e2e/three-scene.spec.ts e2e/external-links.spec.ts",
    "deploy:links": "node scripts/check-external-links.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm dist:check"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.13.0",
    "marked": "^18.1.1",
    "radix-ui": "~1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vercel/routing-utils": "6.6.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "~5.0.3"
  }
}
